# Public Supabase credentials (safe to expose to the browser via Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Private server-only credentials (never exposed to the browser)
# SUPABASE_URL can match VITE_SUPABASE_URL — it is kept separate so
# server-side code never accidentally imports the public VITE_ variant.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
